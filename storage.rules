rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.token.email in ['kuttawaala@gmail.com', 'admin@kuttawaala.com']);
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isUnderSizeLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Avatars (Auth'ed users can read and write their own avatar)
    match /avatars/{userId}/{fileName} {
      allow read: if true; // Avatars might need to be public for UI, though strictly could be owner-only
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isImage() && isUnderSizeLimit(5);
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Memorial Images (Auth'ed users can upload, public can view)
    match /memorial-images/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImage() && isUnderSizeLimit(5);
      allow delete: if isAdmin() || (isAuthenticated() && resource.metadata.userId == request.auth.uid);
    }

    // Report Images (Anyone can upload reports, public can view)
    match /report-images/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && isUnderSizeLimit(5);
      allow delete: if isAdmin() || (isAuthenticated() && resource.metadata.userId == request.auth.uid);
    }
    
    // Cats/Dogs/Vets Images (Only admin can write, public can view)
    match /cat-images/{fileName} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /dog-images/{fileName} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /vet-images/{fileName} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
